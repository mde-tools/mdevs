<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="mdevs.91f72ca7-7cd1-472b-98ba-20909b2c603c" Version="1.0.4.0" Language="en-US" Publisher="mde-tools" />
    <DisplayName>mdevs - WYSIWYG Markdown Editor for Visual Studio</DisplayName>
    <!-- 一行の説明は英語だけにする（Marketplace は、ここの日本語を「?」に化けさせて表示するため） -->
    <Description>WYSIWYG Markdown editor: edit Markdown files directly in the preview, with easy tables, check boxes in table cells, pasted images, and Excel copy and paste.</Description>
    <!-- インストールの画面に表示するライセンス（mdevs のライセンスと、WebView2 のライセンス） -->
    <License>LICENSE.txt</License>
    <Icon>images\mde.png</Icon>
    <!-- Marketplace・「拡張機能の管理」の検索に使う言葉 -->
    <Tags>Markdown;WYSIWYG;Editor;md;Markdown Editor;Preview;Table;Checklist;Checkbox;Excel;Image</Tags>
  </Metadata>
  <Installation>
    <!-- 下限は Marketplace が受け付ける最新の安定版 API（17.14）。Visual Studio 2026（18.x）にもこの指定でインストールできる -->
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14, )">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <!-- Professional・Enterprise も Community の指定で入れられるが、Marketplace の対応エディションの表示に出すため、明示する -->
    <InstallationTarget Id="Microsoft.VisualStudio.Pro" Version="[17.14, )">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[17.14, )">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.5,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.14, )" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
  </Assets>
</PackageManifest>
